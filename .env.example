
# AWS
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
AWS_PROFILE=default                         # or use IAM role in SageMaker Studio

# SageMaker
SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789012:role/SageMakerExecutionRole
S3_BUCKET=road-seg-bucket
SAGEMAKER_ENDPOINT_NAME=road-seg-endpoint

# MLflow
MLFLOW_TRACKING_URI=http://your-mlflow-server:5000
MLFLOW_EXPERIMENT_NAME=road-segmentation

# Alerts
SNS_ALERT_ARN=arn:aws:sns:us-east-1:123456789012:road-seg-alerts

# App
ENV=development
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.amplifyapp.com
