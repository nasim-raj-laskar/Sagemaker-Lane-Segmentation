# ─────────────────────────────────────────────────────────────────────────────
# docker/Dockerfile.training
# GPU-enabled training image pushed to ECR and used by SM Training Jobs.
# Build:
#   docker build -f docker/Dockerfile.training -t perceptron-training:latest .
# ─────────────────────────────────────────────────────────────────────────────

FROM tensorflow/tensorflow:2.13.0-gpu

LABEL project="self-driving-perceptron" \
      component="training" \
      maintainer="your-team"

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1-mesa-glx \
        libglib2.0-0 \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/ml/code

# Install Python deps first (layer caching)
COPY pyproject.toml .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
        "albumentations>=1.3" \
        "boto3>=1.26" \
        "mlflow>=2.8" \
        "opencv-python-headless>=4.8" \
        "pydantic>=2.0" \
        "PyYAML>=6.0" \
        "scikit-learn>=1.3" \
        "sagemaker>=2.180" \
        "smart-open[s3]>=6.4"

# Copy source
COPY config/    config/
COPY src/       src/
COPY scripts/   scripts/

ENV PYTHONPATH=/opt/ml/code
ENV TF_CPP_MIN_LOG_LEVEL=2

ENTRYPOINT ["python", "src/training/train.py"]
