# ─────────────────────────────────────────────────────────────────────────────
# docker/Dockerfile.inference
# Lightweight CPU inference image for SM real-time endpoint.
# Build:
#   docker build -f docker/Dockerfile.inference -t perceptron-inference:latest .
# ─────────────────────────────────────────────────────────────────────────────

FROM tensorflow/tensorflow:2.13.0

LABEL project="self-driving-perceptron" \
      component="inference"

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1-mesa-glx \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/ml/code

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
        "boto3>=1.26" \
        "opencv-python-headless>=4.8" \
        "PyYAML>=6.0" \
        "sagemaker-inference>=1.8"

COPY config/          config/
COPY src/inference/   src/inference/
COPY src/utils/       src/utils/

ENV PYTHONPATH=/opt/ml/code
ENV TF_CPP_MIN_LOG_LEVEL=2
# SageMaker reads these env vars to locate serve.py
ENV SAGEMAKER_PROGRAM=serve.py
ENV SAGEMAKER_SUBMIT_DIRECTORY=/opt/ml/code

EXPOSE 8080

# SageMaker's default nginx+gunicorn stack calls serve
CMD ["python", "-m", "sagemaker_inference.serving"]
